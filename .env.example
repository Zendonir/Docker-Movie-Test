# Beispielwerte – als .env neben docker-compose.yml ablegen oder in TrueNAS als Umgebungsvariablen eintragen
TZ=Europe/Berlin
PUID=3000
PGID=3000
# Zusätzliche Gruppen (kommagetrennt), z. B. 568 für "apps" auf TrueNAS
SUPPLEMENTARY_GROUPS=
# Maximal gleichzeitig geprüfte Dateien (Standard 1)
MAX_CONCURRENT_SCANS=1
# FFmpeg-Decoder-Threads je Prüfung (0 = alle Kerne)
FFMPEG_THREADS=2
# CPU-Priorität 0–19 (19 = niedrigste)
NICE_LEVEL=10
# E/A-Priorität: idle | best-effort-low | best-effort | normal
IO_PRIORITY=best-effort-low
# Mehrere Medienwurzeln mit ":" trennen, z. B. /media:/media2
MEDIA_ROOT=/media
# Bibliothek beim ersten Start automatisch anlegen
AUTO_CREATE_LIBRARY=true
# Optionale Anmeldung
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=
# Reparaturfunktion (Remux in neue Datei unter /config/repaired) – standardmäßig aus
REPAIR_ENABLED=false
# Temporärer Speicher für den optionalen Diagnose-Remux
SCAN_TMP_DIR=/config/tmp
LOG_LEVEL=INFO
